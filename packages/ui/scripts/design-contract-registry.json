{
  "schemaVersion": 1,
  "organisms": [
    {
      "id": "organism:startup-shell",
      "owner": {
        "kind": "export",
        "file": "packages/ui/src/components/shell/StartupShell.tsx",
        "symbol": "StartupShell"
      },
      "responsibility": "Owns the application startup lifecycle across loading, failure, pairing, and bootstrap states.",
      "dependsOn": [
        "atom:alert",
        "atom:badge",
        "atom:button",
        "atom:card",
        "atom:input",
        "atom:separator"
      ],
      "grants": ["layout.viewport", "layout.region", "semantics.landmark"],
      "lifecycleOwner": "application-startup"
    },
    {
      "id": "organism:vault-workspace",
      "owner": {
        "kind": "export",
        "file": "packages/ui/src/components/settings/SecretsManagerSection.tsx",
        "symbol": "VaultWorkspace"
      },
      "responsibility": "Owns one Vault activation's shared data loading, mutation refresh, tab and hash navigation, cross-tab focus, scrolling, and dialog or page presentation lifecycle.",
      "dependsOn": [
        "atom:alert",
        "atom:badge",
        "atom:banner",
        "atom:button",
        "atom:card",
        "atom:checkbox",
        "atom:dialog",
        "atom:input",
        "atom:radioGroup",
        "atom:select",
        "atom:separator",
        "atom:table",
        "atom:tabs"
      ],
      "grants": [
        "paint.surface",
        "paint.border",
        "paint.radius",
        "interaction.select",
        "interaction.focus-region",
        "layout.container",
        "layout.region",
        "layout.scroll-owner",
        "semantics.content"
      ],
      "lifecycleOwner": "vault-activation-and-navigation"
    },
    {
      "id": "organism:wallet-dashboard",
      "owner": {
        "kind": "export",
        "file": "plugins/plugin-wallet/src/ui/components/InventoryAppView.tsx",
        "symbol": "InventoryAppView"
      },
      "responsibility": "Owns the full-screen wallet dashboard: its balances, NFT, and trading-profile fetch and poll lifecycle, and the holdings rail, activity log, movers, positions, and NFT panels it renders inside the inventory view and the crypto terminal.",
      "dependsOn": ["atom:avatar", "atom:button", "atom:skeleton"],
      "grants": [
        "paint.surface",
        "paint.border",
        "paint.radius",
        "interaction.activate",
        "layout.container",
        "layout.region",
        "semantics.content"
      ],
      "lifecycleOwner": "wallet-data-pipeline"
    }
  ],
  "pageShells": [
    {
      "id": "page-shell:page-frame",
      "owner": {
        "kind": "export",
        "file": "packages/ui/src/layouts/page-frame/page-frame.tsx",
        "symbol": "PageFrame"
      },
      "responsibility": "Owns canonical page width, gutter, scroll-boundary, and landmark topology for classified content, workspace, and immersive routes.",
      "dependsOn": [],
      "grants": [
        "layout.viewport",
        "layout.container",
        "layout.region",
        "layout.scroll-owner",
        "semantics.landmark"
      ],
      "supportedLayoutKinds": ["content", "workspace", "immersive"],
      "supportedTopologies": ["framed"]
    }
  ]
}
