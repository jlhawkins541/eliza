# Crypto Queen agent settings. Copy this file to packages/agent/.env (the file
# `bun run start` reads), fill in the blanks, then run
# `bun run --cwd plugins/plugin-wallet check:crypto-queen`.
# Never commit the filled-in copy: it holds your wallet key.

# Character: an absolute path, or relative to packages/agent, where the agent runs.
ELIZA_CHARACTER_PATH=../../plugins/plugin-wallet/characters/crypto-queen.json

# @elizaos/plugin-zerollama: a running Ollama server and models pulled on it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SMALL_MODEL=llama3.1
OLLAMA_LARGE_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Uncomment if a small model rejects structured output.
# OLLAMA_DISABLE_STRUCTURED_OUTPUT=true

# @elizaos/plugin-wallet: Solana. Without SOLANA_RPC_URL the wallet skips
# Solana entirely. A private RPC (Helius, Triton, QuickNode) is steadier than
# the public endpoint for sending trades.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Base58 secret key of a separate hot wallet that holds only trading funds.
# Leave empty to run read-only; the Real trade tab then can't sign.
SOLANA_PRIVATE_KEY=
# Largest SOL amount one terminal buy may spend (default 1).
WALLET_TERMINAL_MAX_BUY_SOL=1
# Tip in lamports for trades sent privately through Jito (1000 to 4000000,
# default 100000 = 0.0001 SOL), and the block engine they go to.
WALLET_TERMINAL_JITO_TIP_LAMPORTS=100000
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Optional data keys that raise rate limits.
HELIUS_API_KEY=
BIRDEYE_API_KEY=
COINGECKO_API_KEY=

# @elizaos/plugin-sql: leave empty to use embedded PGlite (nothing to install).
POSTGRES_URL=
# PGLITE_DATA_DIR=.eliza/.elizadb
